{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Studio Lite",
  "mainBinaryName": "MarkdownStudioLite",
  "version": "1.13.0",
  "identifier": "com.zpl.markdownstudiolite",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Markdown Studio Lite",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "MarkdownStudioLite.md",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ]
  }
}
